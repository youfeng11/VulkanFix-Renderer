#version 450
layout(local_size_x=1, local_size_y=1, local_size_z=1) in;
layout(set=0, binding=0) uniform sampler3D source;
layout(set=0, binding=1, std430) buffer Output { uint words[]; } outputData;
void main() {
    ivec3 size = textureSize(source, 0);
    ivec3 at = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(at, size))) return;
    uint index = uint((at.z * size.y + at.y) * size.x + at.x);
    outputData.words[index] = packUnorm4x8(texelFetch(source, at, 0));
}
