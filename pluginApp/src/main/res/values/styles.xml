<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VulkanFix" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorBackground">@color/screen_background</item>
        <item name="android:colorBackgroundFloating">@color/panel_background</item>
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/screen_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="Widget.VulkanFix.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
